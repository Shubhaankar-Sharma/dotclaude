{
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(~/.claude/**)",
      "Bash(~/.claude/hooks/**)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(cd *)",
      "Bash(go *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(npx *)",
      "Bash(codex *)",
      "Bash(gh *)",
      "Bash(cat *)",
      "Bash(mktemp *)",
      "Bash(which *)",
      "mcp__playwright__*",
      "WebSearch",
      "WebFetch"
    ]
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/register-session.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/focus-workspace.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/focus-workspace.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-waiting.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-active.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-active.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true
}
